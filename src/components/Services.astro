---
import Icon from './Icon.astro';

// Блок «Что беру на себя» — иллюстрация-схема + «плавающие» подписи вокруг неё
// (повтор блока из исходного дизайна). На узких экранах — аккуратный список.
const items = [
  { icon: 'ip',      pos: 'lbl1', title: 'ВЕДЕНИЕ УЧЁТА ИП И ООО',           desc: 'Полный цикл бухгалтерии. Точно, вовремя, по стандартам.' },
  { icon: 'report',  pos: 'lbl2', title: 'СДАЧА ОТЧЁТНОСТИ В ФНС, СФР',       desc: 'Гарантия сдачи вовремя. Без ошибок и штрафов.' },
  { icon: 'restore', pos: 'lbl3', title: 'ВОССТАНОВЛЕНИЕ УЧЁТА',              desc: 'Исправление ошибок прошлых периодов, аудит.' },
  { icon: 'envelope',pos: 'lbl4', title: 'СОПРОВОЖДЕНИЕ ПРОВЕРОК',            desc: 'Защита интересов, ответы на запросы налоговой.' },
  { icon: 'audit',   pos: 'lbl5', title: 'РАСЧЁТ ЗАРПЛАТЫ И КАДРЫ',           desc: 'Учёт сотрудников, начисления, отпуска, больничные.' },
  { icon: 'scales',  pos: 'lbl6', title: 'НАЛОГОВОЕ ПЛАНИРОВАНИЕ И ОПТИМИЗАЦИЯ', desc: 'Легальное снижение налоговой нагрузки, стратегии.' },
];
---
<section class="sec" id="uslugi">
  <div class="wrap">
    <div class="svcblock">
      <!-- интро -->
      <div class="svcintro">
        <div class="eyebrow2">УСЛУГИ</div>
        <h2 class="svch2">Что я беру на&nbsp;себя</h2>
        <a href="#zayavka" class="btn">Бесплатная консультация</a>
      </div>

      <!-- иллюстрация -->
      <img class="svcimg" src="/assets/services-flow.png" alt="Схема бухгалтерских услуг" loading="lazy" />

      <!-- плавающие подписи (десктоп) -->
      {items.map((it) => (
        <div class={`svclbl ${it.pos}`}>
          <div class="t">{it.title}</div>
          <div class="d">{it.desc}</div>
        </div>
      ))}

      <!-- список (мобильные) -->
      <div class="svclist">
        {items.map((it) => (
          <div class="row">
            <span class="ic"><Icon name={it.icon} size={24} stroke="#5fb094" width={1.6} /></span>
            <div>
              <div class="t">{it.title}</div>
              <div class="d">{it.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svcblock { position: relative; min-height: 340px; }

  .svcintro { position: absolute; left: 0; top: 24px; width: 260px; z-index: 2; }
  .eyebrow2 { font-size: 14px; font-weight: 600; color: var(--ink); letter-spacing: .16em; margin-bottom: 18px; }
  .svch2 { font-weight: 800; font-size: clamp(34px, 4.2vw, 56px); line-height: .98; letter-spacing: -.03em; margin: 0 0 30px; }

  .svcimg { position: absolute; left: 52%; top: 8px; width: 30%; max-width: 340px; height: auto; z-index: 1; pointer-events: none; }

  .svclbl { position: absolute; z-index: 2; }
  .svclbl .t { font-size: 13.5px; font-weight: 800; letter-spacing: .02em; color: var(--ink); margin-bottom: 5px; }
  .svclbl .d { font-size: 13px; line-height: 1.45; color: var(--muted); }

  .lbl1 { left: 75%; top: 30px;  width: 23%; }
  .lbl2 { left: 81%; top: 104px; width: 18%; }
  .lbl3 { left: 80%; top: 184px; width: 19%; }
  .lbl4 { left: 75%; top: 258px; width: 23%; }
  .lbl5 { right: 48%; top: 168px; width: 21%; text-align: right; }
  .lbl6 { right: 52%; top: 248px; width: 20%; text-align: right; }

  .svclist { display: none; flex-direction: column; gap: 24px; }
  .svclist .row { display: flex; gap: 15px; }
  .svclist .ic { flex: none; width: 52px; height: 52px; border-radius: 50%; background: #fff; border: 1.5px solid var(--green-200); display: flex; align-items: center; justify-content: center; }
  .svclist .t { font-size: 15px; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
  .svclist .d { font-size: 14px; line-height: 1.5; color: var(--muted); }

  /* на узких экранах — прячем иллюстрацию и подписи, показываем список */
  @media (max-width: 1040px) {
    .svcblock { min-height: auto; }
    .svcintro { position: static; width: auto; margin-bottom: 26px; }
    .svcimg, .svclbl { display: none; }
    .svclist { display: flex; }
  }
</style>
