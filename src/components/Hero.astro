---
import Icon from './Icon.astro';
import Messengers from './Messengers.astro';
import { hero, trustChips, brand, contacts } from '../data/site';
---
<section class="hero" aria-label="Главный экран">
  <div class="scrim"></div>
  <!-- Фото во всю ширину — планшет и мобильные (на десктопе фото в фоне секции) -->
  <div class="hero-photo" role="img" aria-label={`Бухгалтер ${brand.person}, ${brand.city}`}></div>

  <div class="wrap content">
    <div class="card glass">
      <h1>{hero.h1}</h1>
      <p class="sub">{hero.sub}</p>

      <div class="cta">
        <a href={contacts.phoneHref} class="btn"><Icon name="phone" size={19} stroke="#fff" width={2} />{hero.primaryCta}</a>
        <span class="write">
          <span class="write-lbl">Написать</span>
          <span class="write-icons"><Messengers /></span>
        </span>
      </div>

      <div class="chips">
        {trustChips.map((c) => (
          <div class="chip">
            <span class="chk"><Icon name="check" size={21} stroke="#5fb094" width={2.4} /></span>
            <span class="txt">
              <b>{c.type === 'rating' ? c.rating : c.strong}</b><br />
              {c.type === 'rating'
                ? <span class="stars" aria-label={`Рейтинг ${c.rating} из 5`}>★★★★★</span>
                : c.sub}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(680px, 44vw, 800px);
    background-image: url('/assets/hero.jpg');
    background-size: cover; background-position: 82% 44%; background-repeat: no-repeat;
  }
  /* лёгкая БЕЛАЯ дымка слева (без синевы), чтобы левая часть была воздушной */
  .scrim {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      rgba(255,255,255,.72) 0%,
      rgba(255,255,255,.4) 34%,
      rgba(255,255,255,.08) 52%,
      rgba(255,255,255,0) 68%);
  }
  .content {
    position: relative; min-height: inherit;
    display: flex; flex-direction: column; justify-content: center;
    padding-top: calc(var(--hdr-h) + 26px); padding-bottom: 40px;
  }

  /* матовое стекло на БЕЛОМ */
  .glass {
    background: #ffffff00;
    backdrop-filter: blur(22px) saturate(1.12);
    -webkit-backdrop-filter: blur(22px) saturate(1.12);
    border: 1px solid rgba(255, 255, 255, .8);
    box-shadow: 0 24px 64px rgba(42, 52, 80, .14);
  }
  .card { max-width: 660px; border-radius: 30px; padding: 44px; }
  .hero-photo { display: none; }

  h1 { font-weight: 800; font-size: clamp(30px, 3.7vw, 44px); line-height: 1.1; margin-bottom: 18px; }
  .sub { font-size: 18px; line-height: 1.55; color: var(--muted); margin: 0 0 28px; max-width: 560px; }

  .cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; --msgr-size: 55px; }
  .cta .btn { padding: 15px 24px; }
  /* «Написать» + иконки в строке, в рамке-пилюле по высоте кнопки */
  .write {
    display: inline-flex; align-items: center; gap: 12px;
    height: 55px; padding: 0 16px;
    border: 1px solid var(--line-2); border-radius: 14px;
    background: rgba(255, 255, 255, .35);
  }
  .write-lbl { font-size: 14px; font-weight: 600; color: var(--muted); }
  .write-icons { display: inline-flex; gap: 8px; --msgr-size: 38px; }
  .btn-glass {
    background: rgba(255, 255, 255, .5);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: var(--ink); border: 1px solid rgba(42, 52, 80, .14);
  }
  .btn-glass:hover { background: rgba(255, 255, 255, .75); }

  .note { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 14px; margin-top: 18px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.18); flex: none; }

  /* чипы без «стекла» — просто галочка + текст */
  .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .chip { display: flex; align-items: center; gap: 10px; }
  .chk { display: flex; align-items: center; justify-content: center; flex: none; }
  .txt { font-size: 13px; line-height: 1.25; color: var(--muted); }
  .txt b { color: var(--ink); font-size: 14.5px; }
  .stars { color: #f5a623; font-size: 15px; letter-spacing: 1.5px; }

  /* на широких экранах кадр шире → лицо поднимается, компенсируем сдвигом вниз */
  @media (min-width: 1500px) { .hero { background-position: 82% 32%; } }
  @media (min-width: 1750px) { .hero { background-position: 82% 26%; } }

  /* ——— планшет и мобильные: фото во всю ширину сверху, под ним стеклянная карточка ——— */
  @media (max-width: 1024px) {
    .hero {
      background-image: none; background: #fff; min-height: auto;
      padding-top: 0;
    }
    .scrim { display: none; }

    /* Фото от самого верха страницы — шапка «плавает» поверх кадра, как на десктопе.
       background-size: auto 115% (а не cover) даёт крупный план и возвращает работоспособность
       background-position-y: при cover кадр вписывается по высоте ровно и сдвиг по Y не работает. */
    .hero-photo {
      display: block; width: 100%;
      height: clamp(430px, 66vw, 620px);
      background-image:
        /* лёгкая дымка сверху — чтобы текст шапки читался поверх кадра */
        linear-gradient(180deg, rgba(255,255,255,.5) 0, rgba(255,255,255,0) 120px),
        linear-gradient(180deg, rgba(255,255,255,0) 62%, rgba(255,255,255,.45) 100%),
        url('/assets/hero.jpg');
      background-repeat: no-repeat;
      background-size: auto, auto, auto 115%;
      background-position: center top, center top, 88% 0;
      background-color: #eef2f6;
    }

    /* карточка наезжает на низ фото — стекло реально размывает кадр под собой */
    .content {
      display: block; position: relative; z-index: 2;
      min-height: 0; margin-top: -40px;
      padding-top: 0; padding-bottom: 44px;
    }
    .card { max-width: none; border-radius: 26px; padding: 30px 26px; }
  }

  @media (max-width: 760px) {
    .hero-photo {
      height: clamp(380px, 98vw, 520px);
      background-size: auto, auto, auto 118%;
      background-position: center top, center top, 86% 0;
    }
    .content { margin-top: -34px; padding-bottom: 38px; }
    .card { border-radius: 24px; padding: 24px 20px; }

    h1 { font-size: clamp(26px, 7.4vw, 33px); margin-bottom: 14px; }
    .sub { font-size: 15.5px; margin-bottom: 22px; }

    .cta { --msgr-size: 50px; gap: 10px; }
    .cta .btn { padding: 14px 22px; }
    .write { height: 50px; }

    .chips { gap: 14px 20px; margin-top: 24px; }
    .chip { max-width: none; }
  }

  @media (max-width: 380px) {
    .chips { gap: 12px 14px; }
    .txt { font-size: 12.5px; }
    .txt b { font-size: 13.5px; }
  }
</style>
