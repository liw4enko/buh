---
import Icon from './Icon.astro';
import Messengers from './Messengers.astro';
import { hero, trustChips, brand, contacts } from '../data/site';
---
<section class="hero" aria-label="Главный экран">
  <div class="scrim"></div>
  <div class="wrap content">
    <div class="card glass">
      <h1>{hero.h1}</h1>
      <p class="sub">{hero.sub}</p>

      <div class="cta">
        <a href={contacts.phoneHref} class="btn"><Icon name="phone" size={19} stroke="#fff" width={2} />{hero.primaryCta}</a>
        <span class="write">
          <span class="write-lbl">Написать</span>
          <Messengers />
        </span>
      </div>

      <div class="note"><span class="dot"></span> Отвечаю на заявку в течение {brand.responseTime} в рабочее время</div>

      <div class="chips">
        {trustChips.map((c) => (
          <div class="chip">
            <span class="chk"><Icon name="check" size={21} stroke="#5fb094" width={2.4} /></span>
            <span class="txt">
              <b>{c.type === 'rating' ? c.rating : c.strong}</b><br />
              {c.type === 'rating'
                ? <span class="stars" aria-label={`Рейтинг ${c.rating} из 5`}>★★★★★</span>
                : c.sub}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(680px, 44vw, 800px);
    background-image: url('/assets/hero.jpg');
    background-size: cover; background-position: 82% 44%; background-repeat: no-repeat;
  }
  /* лёгкая БЕЛАЯ дымка слева (без синевы), чтобы левая часть была воздушной */
  .scrim {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      rgba(255,255,255,.72) 0%,
      rgba(255,255,255,.4) 34%,
      rgba(255,255,255,.08) 52%,
      rgba(255,255,255,0) 68%);
  }
  .content {
    position: relative; min-height: inherit;
    display: flex; flex-direction: column; justify-content: center;
    padding-top: calc(var(--hdr-h) + 26px); padding-bottom: 40px;
  }

  /* матовое стекло на БЕЛОМ */
  .glass {
    background: rgba(255, 255, 255, .55);
    backdrop-filter: blur(22px) saturate(1.12);
    -webkit-backdrop-filter: blur(22px) saturate(1.12);
    border: 1px solid rgba(255, 255, 255, .8);
    box-shadow: 0 24px 64px rgba(42, 52, 80, .14);
  }
  .card { max-width: 660px; border-radius: 30px; padding: 44px; }

  h1 { font-weight: 800; font-size: clamp(30px, 3.7vw, 44px); line-height: 1.1; margin-bottom: 18px; }
  .sub { font-size: 18px; line-height: 1.55; color: var(--muted); margin: 0 0 28px; max-width: 560px; }

  .cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; --msgr-size: 55px; }
  .cta .btn { padding: 15px 24px; }
  .write { display: inline-flex; align-items: center; gap: 10px; }
  .write-lbl { font-size: 14px; font-weight: 600; color: var(--muted); }
  .btn-glass {
    background: rgba(255, 255, 255, .5);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: var(--ink); border: 1px solid rgba(42, 52, 80, .14);
  }
  .btn-glass:hover { background: rgba(255, 255, 255, .75); }

  .note { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 14px; margin-top: 18px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.18); flex: none; }

  /* чипы без «стекла» — просто галочка + текст */
  .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .chip { display: flex; align-items: center; gap: 10px; }
  .chk { display: flex; align-items: center; justify-content: center; flex: none; }
  .txt { font-size: 13px; line-height: 1.25; color: var(--muted); }
  .txt b { color: var(--ink); font-size: 14.5px; }
  .stars { color: #f5a623; font-size: 13px; letter-spacing: 1px; }

  /* на широких экранах кадр шире → лицо поднимается, компенсируем сдвигом вниз */
  @media (min-width: 1500px) { .hero { background-position: 82% 32%; } }
  @media (min-width: 1750px) { .hero { background-position: 82% 26%; } }

  @media (max-width: 760px) {
    .hero { background-position: 74% 30%; min-height: auto; }
    .scrim { background: linear-gradient(180deg, rgba(255,255,255,.5) 0%, rgba(255,255,255,.75) 60%, rgba(255,255,255,.85) 100%); }
    .content { padding-bottom: 48px; }
    .card { padding: 28px 22px; }
    .chips { grid-template-columns: 1fr; }
    .chip { max-width: none; }
  }
</style>
