---
// Набор линейных иконок (stroke). name -> path(s).
const { name, size = 24, stroke = 'currentColor', width = 1.7, class: cls = '' } = Astro.props;

const icons: Record<string, string> = {
  // логотип-марка (диаграмма)
  logo: '<path d="M5 4v15h15"/><rect x="8.5" y="11" width="2.4" height="5"/><rect x="13.5" y="7.5" width="2.4" height="8.5"/>',
  // услуги
  ip: '<rect x="5" y="3" width="14" height="18" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/>',
  ooo: '<rect x="4" y="8" width="7" height="12"/><rect x="13" y="4" width="7" height="16"/><path d="M3 20h18"/>',
  report: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><line x1="10" y1="12" x2="15" y2="12"/><line x1="10" y1="16" x2="15" y2="16"/>',
  zero: '<circle cx="12" cy="12" r="8"/><path d="M9 9l6 6M15 9l-6 6"/>',
  restore: '<path d="M20 11a8 8 0 1 0-2.3 5.3"/><path d="M20 6v5h-5"/>',
  salary: '<circle cx="9" cy="8" r="3"/><circle cx="16.5" cy="9.5" r="2.2"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><path d="M15 19c.2-2 1.2-3.4 3-3.4s2.8 1.4 3 3.4"/>',
  register: '<path d="M12 3l3 4h-6z"/><line x1="12" y1="7" x2="12" y2="20"/><line x1="8" y1="20" x2="16" y2="20"/><path d="M6 12h12"/>',
  ndfl: '<rect x="4" y="7" width="16" height="11" rx="2"/><path d="M4 8l8 6 8-6"/>',
  // прочее
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  bars: '<rect x="4" y="8" width="7" height="12"/><rect x="13" y="4" width="7" height="16"/><path d="M3 20h18"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  pin: '<path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  check: '<path d="M4 12l5 5L20 6"/>',
  cross: '<path d="M6 6l12 12M18 6L6 18"/>',
};

const p = icons[name] ?? icons.check;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24"
     fill="none" stroke={stroke} stroke-width={width} stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  <Fragment set:html={p} />
</svg>
