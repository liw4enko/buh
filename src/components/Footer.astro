---
import Icon from './Icon.astro';
import { brand, contacts, services } from '../data/site';
const year = 2026;
---
<footer>
  <div class="wrap">
    <div class="grid">
      <div class="col-brand">
        <div class="logo">
          <span class="mark"><Icon name="logo" size={17} stroke="#fff" width={1.9} /></span>
          <span><b>{brand.name}</b><small>{brand.role}</small></span>
        </div>
        <p>Бухгалтерское обслуживание ИП и ООО в {brand.region}. Работаю по договору с финансовой гарантией.</p>
        <div class="msgr">
          <a href={contacts.whatsapp} aria-label="WhatsApp" target="_blank" rel="noopener">WA</a>
          <a href={contacts.telegram} aria-label="Telegram" target="_blank" rel="noopener">TG</a>
          <a href={contacts.phoneHref} aria-label="Позвонить"><Icon name="phone" size={18} stroke="#fff" width={1.9}/></a>
        </div>
      </div>

      <div>
        <h4>Услуги</h4>
        <div class="links">
          {services.slice(0, 6).map((s) => <a href={s.href}>{s.title}</a>)}
        </div>
      </div>

      <div>
        <h4>Контакты</h4>
        <div class="links">
          <a href={contacts.phoneHref}>{contacts.phone}</a>
          <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
          <span>{contacts.address}</span>
          <span>{contacts.hours}</span>
        </div>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} {brand.name}. Бухгалтерские услуги в {brand.city}.</span>
      <a href="#">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: #c6d0e0; padding: 56px 0 28px; }
  .grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 40px; padding-bottom: 34px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .logo { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }
  .mark { width: 34px; height: 34px; border: 1.6px solid rgba(255,255,255,.6); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .logo b { display: block; color: #fff; font-size: 16px; font-weight: 800; }
  .logo small { color: #9fb0c6; font-size: 12px; }
  .col-brand p { font-size: 14px; max-width: 320px; line-height: 1.6; margin: 0 0 16px; }
  h4 { color: #fff; font-size: 15px; margin: 0 0 14px; }
  .links { display: flex; flex-direction: column; gap: 9px; font-size: 15px; }
  .links a:hover { color: #fff; }
  .msgr { display: flex; gap: 10px; }
  .msgr a { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; }
  .msgr a:hover { background: var(--green); }
  .bottom { padding-top: 22px; font-size: 13px; color: #8ba0ba; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
