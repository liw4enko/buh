---
import Icon from './Icon.astro';
import { contacts } from '../data/site';
const { featured = false } = Astro.props;
---
<div class={`flip ${featured ? 'hot' : ''}`}>
  <div class="flip-inner">
    <span class="flip-front">Связаться</span>
    <span class="flip-back">
      <a class="fi fi-phone" href={contacts.phoneHref} aria-label="Позвонить">
        <Icon name="phone" size={20} stroke="#fff" width={2} />
      </a>
      <a class="fi fi-max" href={contacts.maxLink} target="_blank" rel="noopener" aria-label="Написать в МАКС">
        <img src="/assets/max.svg" alt="МАКС" />
      </a>
      <a class="fi fi-tg" href={contacts.telegram} target="_blank" rel="noopener" aria-label="Написать в Telegram">
        <svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M23.91 3.79L20.3 20.84c-.25 1.21-.98 1.5-2 .94l-5.5-4.07-2.66 2.57c-.3.3-.55.56-1.1.56l.4-5.62 10.24-9.25c.44-.39-.1-.61-.69-.22L6.35 13.4l-5.42-1.7c-1.18-.36-1.2-1.17.25-1.73L22.4 2.34c.98-.36 1.84.22 1.51 1.45z"/></svg>
      </a>
    </span>
  </div>
</div>

<style>
  .flip { perspective: 1000px; width: 100%; height: 52px; }
  .flip-inner {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform .55s cubic-bezier(.45,.12,.2,1);
  }
  .flip:hover .flip-inner,
  .flip:focus-within .flip-inner { transform: rotateY(180deg); }

  .flip-front, .flip-back {
    position: absolute; inset: 0; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  /* фронт — как обычная кнопка (ghost по умолчанию, зелёная у выделенной) */
  .flip-front { font-size: 16px; font-weight: 600; background: #fff; color: var(--ink); border: 1px solid var(--line-2); }
  .hot .flip-front { background: var(--green); color: #fff; border: none; }

  /* оборотная сторона — светлая панель с 3 иконками */
  .flip-back { transform: rotateY(180deg); gap: 12px; background: #fff; border: 1px solid var(--line-2); }
  .hot .flip-back { border-color: var(--green-200); background: var(--green-100); }

  .fi { width: 40px; height: 40px; border-radius: 11px; overflow: hidden; flex: none;
        display: flex; align-items: center; justify-content: center; transition: transform .15s; }
  .fi:hover { transform: translateY(-2px); }
  .fi-phone { background: var(--green); }
  .fi-max { background: transparent; }
  .fi-max img { width: 100%; height: 100%; display: block; }
  .fi-tg { background: linear-gradient(180deg, #2AABEE, #229ED9); }
  .fi-tg svg { width: 21px; height: 21px; }

  /* на тач-устройствах наведения нет — сразу показываем иконки */
  @media (hover: none) { .flip-inner { transform: rotateY(180deg); } }
</style>
