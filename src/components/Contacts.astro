---
import Icon from './Icon.astro';
import { brand, contacts } from '../data/site';
---
<section class="band" id="kontakty">
  <div class="wrap sec">
    <div class="grid">
      <div>
        <div class="eyebrow">Контакты</div>
        <h2 class="h2" style="margin-bottom:24px">Где меня найти</h2>

        <div class="who">{brand.name} · {brand.role}</div>

        <div class="rows">
          <a class="row" href={contacts.phoneHref}>
            <span class="ic"><Icon name="phone" size={20} stroke="#fff" width={1.9}/></span>{contacts.phone}
          </a>
          <a class="row" href={`mailto:${contacts.email}`}>
            <span class="ic"><Icon name="mail" size={20} stroke="#fff" width={1.9}/></span>{contacts.email}
          </a>
          <div class="row">
            <span class="ic"><Icon name="pin" size={20} stroke="#fff" width={1.9}/></span>{contacts.address}
          </div>
          <div class="row">
            <span class="ic"><Icon name="clock" size={20} stroke="#fff" width={1.9}/></span>{contacts.hours}
          </div>
        </div>

        <a href="#zayavka" class="btn" style="margin-top:28px;border-radius:999px">Заказать звонок</a>
      </div>

      <!-- __PLACEHOLDER__ — заменить на карту своей карточки Яндекс Бизнеса (точная точка). -->
      <div class="map">
        <iframe title="Карта — Оренбург"
          src="https://yandex.ru/map-widget/v1/?ll=55.096955%2C51.768199&z=13&text=%D0%9E%D1%80%D0%B5%D0%BD%D0%B1%D1%83%D1%80%D0%B3%20%D1%83%D0%BB.%20%D0%A2%D1%83%D1%80%D0%BA%D0%B5%D1%81%D1%82%D0%B0%D0%BD%D1%81%D0%BA%D0%B0%D1%8F%205"
          loading="lazy" frameborder="0"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .band { background: var(--bg-green); border-top: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: start; }
  .who { font-size: 19px; font-weight: 700; margin-bottom: 22px; }
  .rows { display: flex; flex-direction: column; gap: 14px; }
  .row { display: flex; align-items: center; gap: 14px; font-size: 17px; font-weight: 600; color: var(--ink); }
  .ic { flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--green); display: flex; align-items: center; justify-content: center; }
  .map { position: relative; width: 100%; padding-bottom: 72%; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
