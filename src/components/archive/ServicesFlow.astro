---
// АРХИВ (не используется на странице). Блок «Что я беру на себя» —
// иллюстрация-схема + «плавающие» подписи. Чтобы вернуть на главную,
// импортируй этот компонент в src/pages/index.astro.
import Icon from '../Icon.astro';
import { contacts } from '../../data/site';

const items = [
  { icon: 'ip',      pos: 'lbl1', title: 'ВЕДЕНИЕ УЧЁТА ИП И ООО' },
  { icon: 'report',  pos: 'lbl2', title: 'СДАЧА ОТЧЁТНОСТИ В ФНС, СФР' },
  { icon: 'restore', pos: 'lbl3', title: 'ВОССТАНОВЛЕНИЕ УЧЁТА' },
  { icon: 'envelope',pos: 'lbl4', title: 'СОПРОВОЖДЕНИЕ ПРОВЕРОК' },
  { icon: 'audit',   pos: 'lbl5', title: 'РАСЧЁТ ЗАРПЛАТЫ И КАДРЫ' },
  { icon: 'scales',  pos: 'lbl6', title: 'НАЛОГОВОЕ ПЛАНИРОВАНИЕ И ОПТИМИЗАЦИЯ' },
];
---
<section class="sec" id="uslugi-flow">
  <div class="wrap">
    <div class="svcblock">
      <div class="svcintro">
        <div class="eyebrow2">УСЛУГИ</div>
        <h2 class="svch2">Что я беру на&nbsp;себя</h2>
        <a href={contacts.phoneHref} class="btn"><Icon name="phone" size={18} stroke="#fff" width={2} />Позвонить</a>
      </div>

      <img class="svcimg" src="/assets/services-flow.png" alt="Схема бухгалтерских услуг" loading="lazy" />

      {items.map((it) => (
        <div class={`svclbl ${it.pos}`}>
          <div class="t">{it.title}</div>
        </div>
      ))}

      <div class="svclist">
        {items.map((it) => (
          <div class="row">
            <span class="ic"><Icon name={it.icon} size={24} stroke="#5fb094" width={1.6} /></span>
            <div class="rowtxt"><div class="t">{it.title}</div></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svcblock { position: relative; min-height: 370px; }
  .svcintro { position: absolute; left: 0; top: 24px; width: 260px; z-index: 2; }
  .eyebrow2 { font-size: 14px; font-weight: 600; color: var(--ink); letter-spacing: .16em; margin-bottom: 18px; }
  .svch2 { font-weight: 800; font-size: clamp(34px, 4.2vw, 56px); line-height: .98; letter-spacing: -.03em; margin: 0 0 30px; }
  .svcimg { position: absolute; left: 46%; top: 8px; width: 28%; max-width: 320px; height: auto; z-index: 1; pointer-events: none; }
  .svclbl { position: absolute; z-index: 2; }
  .svclbl .t { font-size: 13.5px; font-weight: 800; letter-spacing: .02em; color: var(--ink); }
  .lbl1 { left: 76%; top: 34px;  width: 23%; }
  .lbl2 { left: 76%; top: 122px; width: 23%; }
  .lbl3 { left: 76%; top: 210px; width: 23%; }
  .lbl4 { left: 76%; top: 298px; width: 23%; }
  .lbl5 { right: 55%; top: 150px; width: 21%; text-align: right; }
  .lbl6 { right: 55%; top: 250px; width: 21%; text-align: right; }
  .svclist { display: none; flex-direction: column; gap: 24px; }
  .svclist .row { display: flex; gap: 15px; align-items: center; }
  .svclist .ic { flex: none; width: 52px; height: 52px; border-radius: 50%; background: #fff; border: 1.5px solid var(--green-200); display: flex; align-items: center; justify-content: center; }
  .svclist .t { font-size: 15px; font-weight: 800; color: var(--ink); }
  @media (max-width: 1040px) {
    .svcblock { min-height: auto; }
    .svcintro { position: static; width: auto; margin-bottom: 26px; }
    .svcimg, .svclbl { display: none; }
    .svclist { display: flex; }
  }
</style>
