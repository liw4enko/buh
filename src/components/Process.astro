---
import { process } from '../data/site';
---
<section class="band" id="process">
  <div class="wrap sec">
    <div class="center">
      <div class="eyebrow">Как работаю</div>
      <h2 class="h2">Просто и прозрачно</h2>
    </div>
    <div class="grid">
      {process.map((p) => (
        <div class="step">
          <div class="n">{p.n}</div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .band { background: var(--bg-soft); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 46px; }
  .step { background: #fff; border-radius: var(--radius); padding: 30px; }
  .n { font-size: 15px; font-weight: 700; color: var(--green); margin-bottom: 14px; }
  .step h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .step p { font-size: 15px; line-height: 1.55; color: var(--muted); margin: 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
