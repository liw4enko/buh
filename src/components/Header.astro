---
import Icon from './Icon.astro';
import Messengers from './Messengers.astro';
import { brand, nav, contacts } from '../data/site';
---
<div class="hdr-wrap">
  <div class="wrap">
  <header class="hdr glass">
    <a href="/" class="logo">
      <span class="mark"><Icon name="logo" size={19} stroke="#2a3450" width={1.9} /></span>
      <span class="lg-txt">
        <b>{brand.nameShort}</b>
        <small>{brand.role}</small>
      </span>
    </a>

    <nav class="links" aria-label="Основная навигация">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="right">
      <a href={contacts.phoneHref} class="btn call">
        <Icon name="phone" size={18} stroke="#fff" width={2} /><span class="lbl">{contacts.phone}</span>
      </a>
      <Messengers />
      <button class="burger" aria-label="Меню" onclick="document.querySelector('.links').classList.toggle('open')">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  </div>
</div>

<style>
  .hdr-wrap { position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding-top: 16px; }
  .hdr {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px 12px 22px;
    border-radius: 22px;
  }
  /* стеклянная пилюля на БЕЛОМ (без синевы) */
  .glass {
    background: #ffffff00;
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border: 1px solid rgba(255, 255, 255, .85);
    box-shadow: 0 10px 30px rgba(42, 52, 80, .10);
  }
  .logo { display: flex; align-items: center; gap: 12px; }
  .mark { width: 40px; height: 40px; border-radius: 11px; background: rgba(255,255,255,.7); border: 1px solid rgba(42,52,80,.14); display: flex; align-items: center; justify-content: center; flex: none; }
  .lg-txt b { display: block; font-size: 17px; font-weight: 800; line-height: 1.1; }
  .lg-txt small { display: block; font-size: 11.5px; font-weight: 600; color: var(--muted); }
  .links { display: flex; align-items: center; gap: 26px; font-size: 15px; color: var(--ink); font-weight: 600; }
  .links a:hover { color: var(--green); }
  .right { display: flex; align-items: center; gap: 10px; }
  .call { gap: 8px; padding: 11px 18px; }
  .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; }

  @media (max-width: 1080px) { .links { display: none; } }
  @media (max-width: 760px) {
    .hdr-wrap { padding: 10px 0; }
    .call .lbl { display: none; }
    .call { padding: 10px 12px; }
    .lg-txt small { display: none; }
    .lg-txt b { font-size: 15px; }
    .mark { width: 34px; height: 34px; }
    .right { gap: 7px; }
    .burger { display: flex; padding: 6px; }
  }
  @media (max-width: 480px) {
    .lg-txt { display: none; }   /* оставляем только значок логотипа */
    .links.open {
      display: flex; position: absolute; top: 74px; left: 16px; right: 16px;
      flex-direction: column; align-items: flex-start; gap: 4px;
      border-radius: 18px; padding: 14px 18px;
      background: rgba(255,255,255,.9); backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,.85); box-shadow: 0 10px 30px rgba(42,52,80,.12);
    }
    .links.open a { padding: 8px 0; width: 100%; }
  }
</style>
