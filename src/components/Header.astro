---
import Icon from './Icon.astro';
import { brand, nav, contacts } from '../data/site';
---
<header class="hdr">
  <div class="wrap bar">
    <a href="/" class="logo">
      <span class="mark"><Icon name="logo" size={19} stroke="#2a3450" width={1.9} /></span>
      <span class="lg-txt">
        <b>{brand.name}</b>
        <small>{brand.role}</small>
      </span>
    </a>

    <nav class="links" aria-label="Основная навигация">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="right">
      <a href={contacts.phoneHref} class="phone">{contacts.phone}</a>
      <a href="#zayavka" class="btn">Оставить заявку</a>
      <button class="burger" aria-label="Меню" onclick="document.querySelector('.links').classList.toggle('open')">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .logo { display: flex; align-items: center; gap: 12px; }
  .mark { width: 38px; height: 38px; border: 1.6px solid var(--ink); border-radius: 9px; display: flex; align-items: center; justify-content: center; }
  .lg-txt b { display: block; font-size: 17px; font-weight: 800; letter-spacing: .01em; line-height: 1.1; }
  .lg-txt small { display: block; font-size: 11.5px; font-weight: 600; color: var(--muted); }
  .links { display: flex; align-items: center; gap: 22px; font-size: 15px; color: var(--muted); font-weight: 500; }
  .links a:hover { color: var(--green); }
  .right { display: flex; align-items: center; gap: 16px; }
  .phone { font-weight: 700; font-size: 16px; white-space: nowrap; }
  .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; }

  @media (max-width: 1040px) { .links { display: none; } }
  @media (max-width: 720px) {
    .phone { display: none; }
    .burger { display: flex; }
    .links.open {
      display: flex; position: absolute; top: 72px; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 4px;
      background: #fff; border-bottom: 1px solid var(--line); padding: 12px 24px 18px;
    }
    .links.open a { padding: 8px 0; width: 100%; }
  }
</style>
